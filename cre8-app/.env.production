# 正式鏈在建置時固定；這些是公開設定，不含任何憑證。
VITE_CHAIN_ID=56
VITE_API_BASE=/api
# 唯讀查詢（allowance、餘額、gas）用的公開 RPC。deposit/withdraw 流程會在簽名前先讀
# allowance，而 `readOnlyClient()` 只認 VITE_RPC_URL —— 沒有它，production build 會拋
# 「Reading allowance needs an RPC」（實測主網存款就卡在這裡）。
#
# publicnode 是免費 BSC 端點；只做讀取，不送交易（送交易走使用者錢包的 provider）。
VITE_RPC_URL=https://bsc-rpc.publicnode.com

# Existing CRE8 public Reown project ID.
VITE_WALLETCONNECT_PROJECT_ID=93c5f18997b388472c92201d1f4b9b7c

# 範例基金中真的開放存入／提領的 slug（逗號分隔）。Community 策略（/funds/strategy/:id）不受此限制。
# 留空 = 所有範例基金只開放給 whitelist：
# 使用者可以操作到送出，送出時顯示 whitelist 提示，不簽名、不送交易。測試網那檔建好後把 slug 填進來。
VITE_LIVE_FUNDS=
