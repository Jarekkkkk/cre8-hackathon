# API 的 base path。預設 `/api`（dev 由 vite proxy 轉到 127.0.0.1:8081）。
# 部署時通常也留 `/api`，由反向代理負責；要直連別人的後端才需要填完整 URL。
VITE_API_BASE=/api

# 只在 dev 私鑰模式需要（錢包模式用錢包自己的 transport）。
# 預設 dev 走 vite 的 /rpc proxy（→ 127.0.0.1:8545）。
VITE_RPC_URL=

# Public Reown project ID for WalletConnect on BNB Smart Chain (56 or 97).
VITE_WALLETCONNECT_PROJECT_ID=
