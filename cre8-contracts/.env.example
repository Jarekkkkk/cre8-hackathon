# Copy to .env and fill in your own endpoints. Never commit a real URL: no credentials in the repository.
# BSC mainnet endpoint used by the ATP fork tests (test/atp/fork/*.t.sol).
# When BSC_RPC_URL is empty the fork test calls vm.skip(true) and is reported as skipped, never as passed.
BSC_RPC_URL=
# BNB Chain testnet endpoint (chain 97), consumed by the [rpc_endpoints] alias `bsc_testnet`.
BSC_TESTNET_RPC_URL=
