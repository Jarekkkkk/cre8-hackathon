{
  "name": "cre8-atp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CRE8 ATP off-chain API: strategies, versions and the operation log (Postgres, no ORM).",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "migrate": "bun src/migrate.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "test": "bun test",
    "preflight": "bun scripts/preflight.ts"
  },
  "dependencies": {
    "@scure/bip32": "1.7.0",
    "@zerodev/ecdsa-validator": "^5.4.9",
    "@zerodev/permissions": "5.5.11",
    "@zerodev/sdk": "^5.5.11",
    "dotenv": "^16.6.1",
    "pg": "^8.23.1",
    "tslib": "^2.9.1",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "permissionless": "^0.5.2",
    "typescript": "^5.9.3"
  }
}
