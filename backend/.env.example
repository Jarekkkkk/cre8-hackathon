# Copy to .env and fill in your own values. Never commit a real DATABASE_URL or RPC URL.
# Postgres connection string for the CRE8 off-chain database. Required: src/config.ts throws without it.
DATABASE_URL=postgres://cre8:cre8@localhost:5432/cre8_atp

# HTTP port the API listens on. Default in code: 8080.
PORT=8080

# BNB Chain id. 56 = mainnet (default), 97 = testnet.
CHAIN_ID=56

# EIP-4361 (SIWE) domain the wallet is asked to sign for: a bare authority, no scheme or path.
# Default in code: localhost. Deployments must set their own, e.g. app.cre8.xyz.
AUTH_DOMAIN=localhost

# Optional EIP-4361 uri (the resource the sign-in is for). Empty means http://<AUTH_DOMAIN>.
# Set it explicitly in a deployment, e.g. https://app.cre8.xyz.
AUTH_URI=

# JSON-RPC endpoint for on-chain operations (e.g. an Anvil BSC-mainnet fork, or a public BSC RPC).
# Empty means "chain disabled": strategy create/publish stay DB-only, and enroll returns 400.
RPC_URL=

# Relayer/operator private key (0x-prefixed) that signs on-chain transactions (register/publish/enroll).
# Empty means "chain disabled". Never commit a real key.
OPERATOR_PRIVATE_KEY=

# On-chain AtpRegistry address. Empty means "chain disabled".
REGISTRY_ADDRESS=

# Session key（Kernel permission validator）設定：enroll 會用這兩項部署一個「已安裝 session key 權限」的
# smart account，並把 session key 的派生路徑寫進 DB（私鑰永不落 DB）。未設時 enroll 會帶著變數名失敗。
# Session key CallPolicy 允許呼叫的 target（rebalance executor 合約地址）。
EXECUTOR_ADDRESS=

# HD 派生 session key 的 master seed（0x + 64 hex）。派生路徑 m/44'/60'/0'/0/<index>，
# index 由 keccak256(owner, strategyId) 決定，所以同一 (owner, strategyId) 重跑必然同一把金鑰。
SESSION_KEY_MASTER_SEED=

# Where the UserOp is submitted. Empty = the direct eth_sendUserOperation path against
# BUNDLER_URL. The bundler relay (POST /bundler) forwards here too.
BUNDLER_URL=http://127.0.0.1:3001

# Enables POST /portfolios/:id/rebalance — an OPERATOR endpoint that signs with the
# account's session key and sends a real on-chain transaction, i.e. it moves the
# portfolio's money. Default OFF: without this the endpoint answers 403
# OPERATOR_REBALANCE_DISABLED and does not exist as far as callers are concerned.
# A deployment that runs the scheduler does not need it. Turn it on deliberately.
ENABLE_OPERATOR_REBALANCE=
